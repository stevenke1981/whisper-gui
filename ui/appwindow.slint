import { Button, ComboBox, LineEdit, TextEdit, CheckBox, HorizontalBox, VerticalBox, ProgressIndicator, TabWidget, ScrollView, Slider } from "std-widgets.slint";

export struct Settings {
    model_path: string,
    language: string,
    send_mode: string,
    http_url: string,
    gpu_enabled: bool,
    hotkey: string,
    output_dir: string,
    hotkey_toggle_enabled: bool,
    hotkey_ptt_enabled: bool,
    correction_enabled: bool,
    gain_enabled: bool,
    gain_level: float,
}

// ── Light / Dark theme palette ────────────────────────────────────────────
global Theme {
    in-out property <bool> dark: true;

    out property <color> bg:         dark ? #0d1117 : #f6f8fa;
    out property <color> surface:    dark ? #161b22 : #ffffff;
    out property <color> card:       dark ? #21262d : #ffffff;
    out property <color> border:     dark ? #30363d : #d0d7de;

    out property <color> accent:     dark ? #388bfd : #0969da;
    out property <color> accent-dim: dark ? #1c4591 : #ddf4ff;

    out property <color> text:       dark ? #c9d1d9 : #1f2328;
    out property <color> text-dim:   dark ? #8b949e : #656d76;

    out property <color> success:    dark ? #3fb950 : #1a7f37;
    out property <color> danger:     dark ? #f85149 : #d1242f;
    out property <color> warning:    dark ? #e3b341 : #9a6700;

    out property <color> shadow:     dark ? #00000050 : #0000001a;
}

// ── Reusable styled card ──────────────────────────────────────────────────
component SectionCard inherits Rectangle {
    in property <string> header: "";
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: 3px;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        if root.header != "": Text {
            text: root.header;
            font-size: 13px;
            color: Theme.text-dim;
            font-weight: 600;
            letter-spacing: 0.8px;
        }
        @children
    }
}

// ── App state ─────────────────────────────────────────────────────────────
export global AppState {
    in-out property <string>   status: "Ready";
    in-out property <string>   transcribed-text: "";
    in-out property <string>   process-log: "";
    in-out property <float>    progress: 0.0;
    in-out property <bool>     is-recording: false;
    in-out property <bool>     is-processing: false;
    in-out property <string>   current-model: "tiny";
    in-out property <string>   current-language: "auto";
    in-out property <string>   memory-usage: "";
    in-out property <string>   gpu-usage: "";
    in-out property <bool>     is-zh: true;
    in-out property <string>   download-model-select: "tiny";
    in-out property <Settings> settings: {
        model_path: "models/ggml-tiny.bin",
        language: "auto",
        send_mode: "clipboard",
        http_url: "",
        gpu_enabled: true,
        hotkey: "",
        output_dir: "output",
        hotkey_toggle_enabled: true,
        hotkey_ptt_enabled: true,
        correction_enabled: true,
        gain_enabled: false,
        gain_level: 2.0,
    };

    callback transcribe-file(string);
    callback start-recording();
    callback stop-recording();
    callback load-model();
    callback save-settings();
    callback load-settings();
    callback select-model-file();
    callback send-text(string);
    callback download-model(string);
    callback preset-model-selected(string);
    callback correct-text();
}

export component AppWindow inherits Window {
    title: AppState.is-zh ? "Whisper GUI — 離線語音辨識" : "Whisper GUI — Offline Speech Recognition";
    preferred-width: 760px;
    preferred-height: 700px;
    min-width: 580px;
    min-height: 480px;
    background: Theme.bg;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Header bar ────────────────────────────────────────────────────
        Rectangle {
            height: 54px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: center;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "🎙";
                        font-size: 22px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "Whisper GUI";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: AppState.is-zh ? "離線語音辨識" : "Offline Speech Recognition";
                            font-size: 11px;
                            color: Theme.text-dim;
                        }
                    }

                    Rectangle {
                        width: 68px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.accent-dim;
                        border-width: 1px;
                        border-color: Theme.accent;
                        Text {
                            text: AppState.current-model;
                            font-size: 12px;
                            color: Theme.accent;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if AppState.gpu-usage != "": Rectangle {
                        width: 90px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.dark ? #0d2a0d : #dcfce7;
                        border-width: 1px;
                        border-color: Theme.success;
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            Rectangle {
                                width: 6px; height: 6px;
                                border-radius: 3px;
                                background: Theme.success;
                            }
                            Text {
                                text: AppState.gpu-usage;
                                font-size: 11px;
                                color: Theme.success;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    theme-btn := Rectangle {
                        width: 32px; height: 30px;
                        border-radius: 6px;
                        background: theme-ta.has-hover ? Theme.border : #00000000;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: Theme.dark ? "☀" : "🌙";
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        theme-ta := TouchArea { clicked => { Theme.dark = !Theme.dark; } }
                        animate background { duration: 120ms; easing: ease; }
                    }

                    lang-btn := Rectangle {
                        width: 64px; height: 30px;
                        border-radius: 6px;
                        background: lang-ta.has-hover ? Theme.border : #00000000;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: AppState.is-zh ? "EN" : "繁中";
                            color: Theme.text-dim;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        lang-ta := TouchArea { clicked => { AppState.is-zh = !AppState.is-zh; } }
                        animate background { duration: 120ms; easing: ease; }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }
        }

        // ── Tab widget ────────────────────────────────────────────────────
        TabWidget {
            vertical-stretch: 1;

            // ── HOME TAB ─────────────────────────────────────────────────
            Tab {
                title: AppState.is-zh ? "  主頁  " : "  Home  ";

                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Model card
                        SectionCard {
                            header: AppState.is-zh ? "模型" : "Model";
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> AppState.settings.model_path;
                                    placeholder-text: "models/ggml-tiny.bin";
                                }
                                Button {
                                    text: AppState.is-zh ? "瀏覽" : "Browse";
                                    clicked => { AppState.select-model-file(); }
                                }
                                ComboBox {
                                    width: 92px;
                                    model: ["tiny", "base", "small", "medium", "large-v3"];
                                    current-value <=> AppState.current-model;
                                    selected(value) => { AppState.preset-model-selected(value); }
                                }
                                Button {
                                    text: AppState.is-zh ? "載入" : "Load";
                                    clicked => { AppState.load-model(); }
                                    enabled: !AppState.is-processing;
                                }
                            }
                        }

                        // Language card
                        SectionCard {
                            header: AppState.is-zh ? "語言" : "Language";
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: AppState.is-zh ? "辨識語言：" : "Language:";
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                }
                                ComboBox {
                                    width: 120px;
                                    model: ["auto","en","zh","ja","ko","de","fr","es","pt","ru","it","nl","pl","ar","tr","vi","th","hi"];
                                    current-value <=> AppState.settings.language;
                                }
                                Rectangle { width: 1px; height: 22px; background: Theme.border; }
                                Rectangle {
                                    width: 76px; height: 24px;
                                    border-radius: 12px;
                                    background: Theme.dark ? #0d2a0d : #dcfce7;
                                    border-width: 1px;
                                    border-color: Theme.success;
                                    Text {
                                        text: "⚡ CUDA";
                                        font-size: 11px;
                                        color: Theme.success;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Audio controls card
                        SectionCard {
                            header: AppState.is-zh ? "音訊輸入" : "Audio Input";
                            VerticalLayout {
                                spacing: 8px;

                                // Row 1: record controls + PTT + file
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    Button {
                                        text: AppState.is-zh ? "🎤 錄音" : "🎤 Rec";
                                        clicked => { AppState.start-recording(); }
                                        enabled: !AppState.is-recording && !AppState.is-processing;
                                    }
                                    Button {
                                        text: AppState.is-zh ? "⏹ 停止" : "⏹ Stop";
                                        clicked => { AppState.stop-recording(); }
                                        enabled: AppState.is-recording;
                                    }

                                    ptt-rect := Rectangle {
                                        width: 150px;
                                        height: 36px;
                                        border-radius: 6px;
                                        background: ptt-ta.pressed
                                            ? #b71c1c
                                            : ptt-ta.has-hover
                                                ? @linear-gradient(135deg, #ef5350, #c62828)
                                                : @linear-gradient(135deg, #e53935, #b71c1c);
                                        opacity: AppState.is-processing ? 0.40 : 1.0;
                                        drop-shadow-blur: ptt-ta.has-hover ? 12px : 3px;
                                        drop-shadow-color: #e5393560;
                                        drop-shadow-offset-y: 2px;

                                        Text {
                                            text: AppState.is-zh ? "🎙 按住說話" : "🎙 Hold PTT";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        ptt-ta := TouchArea {
                                            enabled: !AppState.is-processing;
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down) {
                                                    AppState.start-recording();
                                                }
                                                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                                    if (AppState.is-recording) { AppState.stop-recording(); }
                                                }
                                            }
                                        }
                                        animate opacity { duration: 200ms; easing: ease; }
                                        animate drop-shadow-blur { duration: 150ms; easing: ease; }
                                    }

                                    Button {
                                        text: AppState.is-zh ? "📁 檔案" : "📁 File";
                                        clicked => { AppState.transcribe-file(""); }
                                        enabled: !AppState.is-recording && !AppState.is-processing;
                                    }
                                }

                                // Row 2: status pill + progress
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Rectangle {
                                        width: 110px;
                                        height: 32px;
                                        border-radius: 16px;
                                        background: AppState.is-recording
                                            ? #f8514920
                                            : AppState.is-processing ? #e3b34120 : #3fb95020;
                                        border-width: 1px;
                                        border-color: AppState.is-recording
                                            ? #f8514970
                                            : AppState.is-processing ? #e3b34170 : #3fb95070;

                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            spacing: 5px;
                                            alignment: center;
                                            Rectangle {
                                                width: 6px; height: 6px;
                                                border-radius: 3px;
                                                background: AppState.is-recording
                                                    ? Theme.danger
                                                    : AppState.is-processing ? Theme.warning : Theme.success;
                                            }
                                            Text {
                                                text: AppState.is-recording
                                                    ? (AppState.is-zh ? "錄音中" : "REC")
                                                    : AppState.is-processing
                                                        ? (AppState.is-zh ? "處理中" : "Working")
                                                        : (AppState.is-zh ? "就緒" : "Ready");
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: AppState.is-recording
                                                    ? Theme.danger
                                                    : AppState.is-processing ? Theme.warning : Theme.success;
                                            }
                                        }
                                        animate background { duration: 250ms; easing: ease; }
                                        animate border-color { duration: 250ms; easing: ease; }
                                    }

                                    ProgressIndicator {
                                        progress <=> AppState.progress;
                                        indeterminate: AppState.progress <= 0.0 && AppState.is-processing;
                                        visible: AppState.is-processing;
                                    }
                                }

                                Text {
                                    text: AppState.is-zh
                                        ? "⌨  Ctrl+Shift+R：切換錄音　　Ctrl+Shift+Space：按住說話"
                                        : "⌨  Ctrl+Shift+R: Toggle    Ctrl+Shift+Space: Hold PTT";
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Process log card
                        SectionCard {
                            header: AppState.is-zh ? "處理記錄" : "Process Log";
                            TextEdit {
                                height: 64px;
                                text <=> AppState.process-log;
                                read-only: true;
                                font-size: 12px;
                            }
                        }

                        // Transcription result card
                        SectionCard {
                            header: AppState.is-zh ? "轉錄結果（可直接編輯修改）" : "Transcription (editable)";

                            VerticalLayout {
                                spacing: 6px;

                                // Toolbar: correct button + hint
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    if AppState.settings.correction_enabled: correct-rect := Rectangle {
                                        width: 110px;
                                        height: 28px;
                                        border-radius: 5px;
                                        background: correct-ta.has-hover ? Theme.accent : Theme.accent-dim;
                                        border-width: 1px;
                                        border-color: Theme.accent;
                                        opacity: (AppState.transcribed-text == "" || AppState.is-processing) ? 0.45 : 1.0;

                                        Text {
                                            text: AppState.is-zh ? "✏ 校正文字" : "✏ Correct";
                                            color: correct-ta.has-hover ? #ffffff : Theme.accent;
                                            font-size: 12px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        correct-ta := TouchArea {
                                            enabled: AppState.transcribed-text != "" && !AppState.is-processing;
                                            clicked => { AppState.correct-text(); }
                                        }
                                        animate background { duration: 120ms; easing: ease; }
                                        animate opacity { duration: 150ms; easing: ease; }
                                    }

                                    if AppState.settings.correction_enabled: Text {
                                        text: AppState.is-zh
                                            ? "SymSpell · Harper · LanguageTool（需網路）"
                                            : "SymSpell · Harper · LanguageTool (internet)";
                                        font-size: 11px;
                                        color: Theme.text-dim;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                TextEdit {
                                    min-height: 240px;
                                    text <=> AppState.transcribed-text;
                                    font-size: 16px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // ── SETTINGS TAB ─────────────────────────────────────────────
            Tab {
                title: AppState.is-zh ? "  設定  " : "  Settings  ";

                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Send mode card
                        SectionCard {
                            header: AppState.is-zh ? "傳送模式" : "Send Mode";
                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ComboBox {
                                        width: 150px;
                                        model: ["clipboard", "file", "http-post", "active-window"];
                                        current-value <=> AppState.settings.send_mode;
                                    }
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> AppState.settings.http_url;
                                        placeholder-text: "HTTP URL";
                                        visible: AppState.settings.send_mode == "http-post";
                                    }
                                    Text {
                                        text: AppState.is-zh
                                            ? "貼到快捷鍵前的焦點視窗"
                                            : "Pastes to window focused before hotkey";
                                        font-size: 12px;
                                        color: Theme.text-dim;
                                        visible: AppState.settings.send_mode == "active-window";
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    Button {
                                        text: AppState.is-zh ? "立即傳送" : "Send Now";
                                        clicked => { AppState.send-text(AppState.transcribed-text); }
                                        enabled: AppState.transcribed-text != "";
                                    }
                                }
                            }
                        }

                        // Hotkeys card
                        SectionCard {
                            header: AppState.is-zh ? "快捷鍵設定" : "Hotkey Settings";
                            VerticalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: AppState.is-zh
                                        ? "啟用 Ctrl+Shift+R 切換錄音"
                                        : "Enable Ctrl+Shift+R toggle recording";
                                    checked <=> AppState.settings.hotkey_toggle_enabled;
                                }
                                CheckBox {
                                    text: AppState.is-zh
                                        ? "啟用 Ctrl+Shift+Space 按住說話（PTT）"
                                        : "Enable Ctrl+Shift+Space press-to-talk (PTT)";
                                    checked <=> AppState.settings.hotkey_ptt_enabled;
                                }
                            }
                        }

                        // Correction settings card
                        SectionCard {
                            header: AppState.is-zh ? "校正功能" : "Text Correction";
                            VerticalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: AppState.is-zh
                                        ? "啟用轉錄後自動校正（SymSpell + Harper + LanguageTool）"
                                        : "Auto-correct after transcription (SymSpell + Harper + LanguageTool)";
                                    checked <=> AppState.settings.correction_enabled;
                                }
                                if AppState.settings.correction_enabled: Text {
                                    text: AppState.is-zh
                                        ? "⚠ LanguageTool 需要網路連線。英文拼字校正需在 dicts/ 目錄放置字典檔。"
                                        : "⚠ LanguageTool requires internet. Spell check needs a dict file in dicts/.";
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Recording gain card
                        SectionCard {
                            header: AppState.is-zh ? "錄音增益" : "Recording Gain";
                            VerticalLayout {
                                spacing: 10px;
                                CheckBox {
                                    text: AppState.is-zh
                                        ? "啟用錄音增益（放大麥克風音量）"
                                        : "Enable recording gain (boost microphone volume)";
                                    checked <=> AppState.settings.gain_enabled;
                                }
                                if AppState.settings.gain_enabled: HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    Text {
                                        text: AppState.is-zh ? "增益倍數：" : "Gain level:";
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        font-size: 14px;
                                        min-width: 68px;
                                    }
                                    Slider {
                                        horizontal-stretch: 1;
                                        minimum: 1.0;
                                        maximum: 8.0;
                                        value <=> AppState.settings.gain_level;
                                    }
                                    Rectangle {
                                        width: 48px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: Theme.accent-dim;
                                        border-width: 1px;
                                        border-color: Theme.accent;
                                        Text {
                                            text: AppState.settings.gain_level + "×";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Theme.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Output directory card
                        SectionCard {
                            header: AppState.is-zh ? "輸出目錄（存成檔案模式）" : "Output Directory (Save to File)";
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: AppState.is-zh ? "路徑：" : "Path:";
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> AppState.settings.output_dir;
                                }
                            }
                        }

                        // Download models card
                        SectionCard {
                            header: AppState.is-zh ? "下載模型" : "Download Models";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: AppState.is-zh ? "選擇：" : "Select:";
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                }
                                ComboBox {
                                    width: 110px;
                                    model: ["tiny", "base", "small", "medium", "large-v3"];
                                    current-value <=> AppState.download-model-select;
                                }
                                Rectangle {
                                    width: 78px;
                                    height: 28px;
                                    border-radius: 5px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text {
                                        text: AppState.download-model-select == "tiny"   ? "~75 MB"
                                            : AppState.download-model-select == "base"   ? "~142 MB"
                                            : AppState.download-model-select == "small"  ? "~466 MB"
                                            : AppState.download-model-select == "medium" ? "~1.5 GB"
                                            : "~3.1 GB";
                                        font-size: 12px;
                                        color: Theme.text-dim;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Button {
                                    text: AppState.is-zh ? "⬇ 下載" : "⬇ Download";
                                    enabled: !AppState.is-processing;
                                    clicked => { AppState.download-model(AppState.download-model-select); }
                                }
                            }
                        }

                        // Save / Load
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Button {
                                text: AppState.is-zh ? "💾 儲存設定" : "💾 Save Settings";
                                clicked => { AppState.save-settings(); }
                            }
                            Button {
                                text: AppState.is-zh ? "🔄 載入設定" : "🔄 Load Settings";
                                clicked => { AppState.load-settings(); }
                            }
                        }
                    }
                }
            }
        }

        // ── Status bar ────────────────────────────────────────────────────
        Rectangle {
            height: 34px;
            background: Theme.surface;

            Rectangle {
                y: 0px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: end;

                if AppState.gpu-usage != "": Text {
                    text: "⚡ " + AppState.gpu-usage;
                    font-size: 12px;
                    color: Theme.success;
                    vertical-alignment: center;
                }
                Text {
                    text <=> AppState.status;
                    font-size: 12px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text <=> AppState.memory-usage;
                    font-size: 12px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
            }
        }
    }
}
